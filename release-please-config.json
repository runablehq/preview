{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "rust",
      "package-name": "preview",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "npm/preview/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "npm/preview-linux-x64/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "npm/preview-linux-arm64/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "npm/preview-darwin-x64/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "npm/preview-darwin-arm64/package.json", "jsonpath": "$.version" }
      ]
    }
  }
}
